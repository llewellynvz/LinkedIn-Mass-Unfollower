{
  "manifest_version": 3,
  "name": "LinkedIn Mass Unfollower",
  "version": "2.0",
  "description": "Automatically unfollow all your LinkedIn connections.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-mass-unfollower@psynalytics.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}